# API interne MAZIGHO
MAZIGHO_API_URL=https://studio.mazigho.ch/api
MAZIGHO_API_KEY=
CLONER_API_KEY=
# Identifiants de l’interface web Render (secrets obligatoires en production)
CLONER_UI_USERNAME=
CLONER_UI_PASSWORD=
CLONER_UI_SESSION_SECRET=

# Stockage média MAZIGHO en production (prioritaire sur S3)
BLOB_READ_WRITE_TOKEN=

# Stockage S3 ou compatible S3.
# MAZIGHO utilise actuellement Vercel Blob : renseigner ces variables
# uniquement après avoir provisionné le bucket/CDN de production validé.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=cloned/
S3_ENDPOINT_URL=
PUBLIC_CDN_URL=

# Images
IMAGE_MAX_WIDTH=1600
IMAGE_THUMB_WIDTH=400
IMAGE_UNCHANGED_THRESHOLD_BYTES=102400
ASSET_DOWNLOAD_TIMEOUT_SECONDS=90
ASSET_UPLOAD_TIMEOUT_SECONDS=120
MAZIGHO_IMPORT_TIMEOUT_SECONDS=120

# Service
HOST=0.0.0.0
PORT=8000
MAX_CLONE_DURATION_SECONDS=900
MAX_CONCURRENT_JOBS=3
CLONER_ENABLED=true
